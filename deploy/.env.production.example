# ==============================================================================
# ChargeShare Ubuntu Server Production Environment Configuration
# ==============================================================================

# Server Domain & Public URLs
DOMAIN_NAME=yourdomain.com
API_EXTERNAL_URL=https://api.yourdomain.com
SITE_URL=https://yourdomain.com
ADDITIONAL_REDIRECT_URLS=chargeshare://login-callback,https://yourdomain.com/*

# Database Security (Min 32 characters, random string)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace_with_secure_random_db_password_min_32_chars

# JWT Security
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars

# Supabase API Keys (Pre-generated using the JWT secret above)
# You can generate valid HS256 tokens using jwt.io with the JWT_SECRET
ANON_KEY=replace_with_generated_anon_key_hs256_token
SERVICE_ROLE_KEY=replace_with_generated_service_role_key_hs256_token

# SMTP Email Configuration (Required for sending OTP verification codes)
# Providers: SendGrid, Brevo, Resend, Amazon SES, or local Postfix
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_smtp_api_key
SMTP_ADMIN_EMAIL=noreply@yourdomain.com
MAILER_AUTOCONFIRM=false

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Edge Function / Cron Security Secret
CRON_SECRET=replace_with_random_cron_secret
