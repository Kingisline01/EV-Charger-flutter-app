<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all unencrypted cleartext HTTP traffic in accordance with OWASP Mobile Security Standards -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
